# Keep real values in .env, not in scripts.

# Google/Gmail account for sermon form intake.
SERMON_FORMS_EMAIL=
SERMON_FORMS_APP_PASSWORD=

# For Gmail IMAP fetching, enable IMAP in Gmail and use an app password,
# not the normal account password.

# Planning Center API personal access token pair.
# Create this in Planning Center, not from the regular account password.
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# YouTube automation should use OAuth tokens/client credentials.
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=

# Website publishing depends on the CMS. The public site appears to be a hosted CMS,
# so API access or a browser automation session will need to be confirmed.
WEBSITE_ADMIN_URL=
WEBSITE_API_TOKEN=
