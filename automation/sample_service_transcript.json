      "end": 1806.0,
      "text": "The Gospel of the Lord."
    },
    {
      "start": 1806.0,
      "end": 1811.0,
      "text": "Praise to you Lord Christ."
    },
    {
      "start": 1824.0,
      "end": 1829.0,
      "text": "You may be seated."
    },
    {
      "start": 1830.0,
      "end": 1840.0,
      "text": "Good morning. In the name of the Father and of the Son and of the Holy Spirit."
    },
    {
      "start": 3000.0,
      "end": 3010.0,
      "text": "Through Jesus Christ our Lord. Amen."
    },
    {
      "start": 3014.0,
      "end": 3020.0,
      "text": "Let us stand and confess our faith in the words of the Nicene Creed."
    }
  ]
